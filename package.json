{
  "name": "shared-ai-memory-mcp",
  "version": "0.1.0",
  "description": "Self-hostable Remote MCP server for shared AI memory and artifact recall backed by user-owned storage.",
  "type": "module",
  "main": "dist/server.js",
  "author": "Mehansh Barthwal",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "start": "node dist/server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "memory",
    "supabase",
    "postgresql"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.731.1",
    "@aws-sdk/s3-request-presigner": "^3.731.1",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
