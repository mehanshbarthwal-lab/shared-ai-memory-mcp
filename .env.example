NODE_ENV=development
PORT=3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-side-service-role-key
MEMORY_MCP_TOKEN=replace-with-a-long-random-token
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key-when-oauth-token-storage-is-added

DATABASE_PROVIDER=supabase
LOG_LEVEL=info
MAX_SEARCH_RESULTS=10

ARTIFACT_STORAGE_PROVIDER=local
LOCAL_ARTIFACT_DIR=./artifacts

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_FOLDER_ID=

ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_REDIRECT_URI=
ONEDRIVE_FOLDER_ID=
